{
  "properties": {
    "metadata": {
      "assignedBy": "github.com/hmcts/azure-policy"
    },
    "description": "Deny AKS workloads which do not have automounting API credentials disabled.",
    "displayName": "AKS Disable Automount API Credentials (DTS-SHAREDSERVICESPTL)",
    "enforcementMode": "Default",
    "nonComplianceMessages": [
      {
        "message": "Mounting Kubernetes API service account tokens is blocked by policy. If your workload uses the default service account, configure it to use the service account named after its namespace. If Kubernetes API access is required, contact the Platform team to discuss an exemption."
      }
    ],
    "notScopes": [],
    "parameters": {
      "effect": {
        "value": "Deny"
      },
      "excludedNamespaces": {
        "value": [
          "azureserviceoperator-system",
          "neuvector",
          "monitoring",
          "keda",
          "cert-manager",
          "dynatrace",
          "admin",
          "gatekeeper-system",
          "flux-system",
          "kube-system",
          "jenkins"
        ]
      }
    },
    "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/423dd1ba-798e-40e4-9c4d-b6902674b423",
    "scope": "/subscriptions/6c4d2513-a873-41b4-afdd-b05a33206631"
  },
