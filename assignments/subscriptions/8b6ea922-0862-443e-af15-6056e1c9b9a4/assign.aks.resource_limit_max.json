{
  "properties": {
    "metadata": {
      "assignedBy": "github.com/hmcts/azure-policy"
    },
    "description": "Audit AKS containers whose CPU/memory limits exceed specified maximums. Raised ceiling vs. the HMCTS fleet default (this subscription is excluded from AKSResLimitMax-hmcts) because most namespaces on cft-preview-00-aks host per-PR review-app copies of the ccd stack alongside their own workloads, making a namespace-by-namespace carve-out impractical.",
    "displayName": "AKS Container Resource Limits (DCD-CFTAPPS-DEV)",
    "enforcementMode": "Default",
    "notScopes": [],
    "parameters": {
      "effect": {
        "value": "Audit"
      },
      "cpuLimit": {
        "value": "4"
      },
      "memoryLimit": {
        "value": "8Gi"
      },
      "excludedNamespaces": {
        "value": [
          "kube-system",
          "gatekeeper-system",
          "azure-arc",
          "azure-extensions-usage-system",
          "dynatrace",
          "monitoring",
          "neuvector",
          "cert-manager"
        ]
      },
      "excludedImages": {
        "value": [
          "hmctsprod.azurecr.io/imported/dynatrace/dynatrace-operator:*",
          "ebe20728.live.dynatrace.com/linux/oneagent:*",
          "quay.io/prometheus/node-exporter:*"
        ]
      }
    },
    "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/e345eecc-fa47-480f-9e88-67dcc122b164",
    "scope": "/subscriptions/8b6ea922-0862-443e-af15-6056e1c9b9a4"
  },
  "type": "Microsoft.Authorization/policyAssignments",
  "id": "/subscriptions/8b6ea922-0862-443e-af15-6056e1c9b9a4/providers/Microsoft.Authorization/policyAssignments/AKSResLimitMax-preview",
  "name": "AKSResLimitMax-preview",
  "location": "uksouth",
  "sku": {
    "name": "A0",
    "tier": "Free"
  }
}
