{
  "properties": {
    "displayName": "DTSPO-35033 privilege escalation preview - LS7161",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Preview mutation for one reviewed image and container role. Enable only after sandbox targeting, application and recovery acceptance. Reviewed workload opt-out: hmcts.net/privilege-escalation-exception=approved. The marker does not verify approval.",
    "metadata": {
      "category": "Kubernetes",
      "version": "0.1.0",
      "preview": true
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable only after sandbox targeting, application and recovery acceptance."
        },
        "allowedValues": [
          "Mutate",
          "Disabled"
        ],
        "defaultValue": "Disabled"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.ContainerService/managedClusters"
          },
          {
            "field": "id",
            "equals": "/subscriptions/8b6ea922-0862-443e-af15-6056e1c9b9a4/resourceGroups/cft-preview-00-rg/providers/Microsoft.ContainerService/managedClusters/cft-preview-00-aks"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "source": "Original",
          "namespaces": [
            "ccd",
            "civil",
            "family-public-law",
            "financial-remedy",
            "ia",
            "money-claims",
            "pcs",
            "private-law",
            "probate",
            "pt",
            "sptribs",
            "sscs"
          ],
          "excludedNamespaces": [
            "kube-system",
            "gatekeeper-system",
            "azure-arc",
            "azure-extensions-usage-system",
            "monitoring"
          ],
          "mutationInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          }
        }
      }
    }
  },
  "id": "/providers/Microsoft.Management/managementGroups/HMCTS/providers/Microsoft.Authorization/policyDefinitions/HMCTSNoPrivEscPreviewLS7161",
  "type": "Microsoft.Authorization/policyDefinitions",
  "name": "HMCTSNoPrivEscPreviewLS7161"
}
