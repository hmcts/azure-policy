{
  "properties": {
    "displayName": "DTSPO-35033 privilege escalation pilot - CCDLSlatest",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Pilot mutation for one reviewed image and container role. Enable only for isolated disposable sandbox tests after targeting acceptance. Reviewed workload opt-out: hmcts.net/privilege-escalation-exception=approved. The marker does not verify approval.",
    "metadata": {
      "category": "Kubernetes",
      "version": "0.1.0",
      "preview": true
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable only for isolated disposable sandbox tests after targeting acceptance."
        },
        "allowedValues": [
          "Mutate",
          "Disabled"
        ],
        "defaultValue": "Disabled"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.ContainerService/managedClusters"
          },
          {
            "field": "id",
            "equals": "/subscriptions/b72ab7b7-723f-4b18-b6f6-03b0f2c6a1bb/resourceGroups/cft-sbox-01-rg/providers/Microsoft.ContainerService/managedClusters/cft-sbox-01-aks"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "source": "Original",
          "namespaces": [
            "dtspo-35033-mutation-pilot"
          ],
          "excludedNamespaces": [
            "kube-system",
            "gatekeeper-system",
            "azure-arc",
            "azure-extensions-usage-system",
            "monitoring"
          ],
          "mutationInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          }
        }
      }
    }
  },
  "id": "/providers/Microsoft.Management/managementGroups/HMCTS/providers/Microsoft.Authorization/policyDefinitions/HMCTSNoPrivEscPilotCCDLSlatest",
  "type": "Microsoft.Authorization/policyDefinitions",
  "name": "HMCTSNoPrivEscPilotCCDLSlatest"
}
